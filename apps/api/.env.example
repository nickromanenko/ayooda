FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET= # optional; defaults to <project-id>.firebasestorage.app
# Option A (production): inline JSON of service account key
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B (local dev): path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
PINECONE_API_KEY=
PINECONE_INDEX=ayooda-dev
GEMINI_API_KEY=
# Cloud Run Jobs execution URL (leave empty for local dev — scraper spawns as a child process)
SCRAPER_JOB_URL=
# Base URL for the widget JS bundle served from Firebase Hosting CDN
WIDGET_BASE_URL=https://ayooda-1791f.web.app
ALLOWED_ORIGINS=http://localhost:3000
PORT=3001
# Langfuse LLM tracing (https://cloud.langfuse.com)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
