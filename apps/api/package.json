{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "typecheck": "tsc --noEmit",
    "kb:import": "bun run src/scripts/import-knowledge-base.ts",
    "admin:grant": "bun run src/scripts/manage-platform-admin.ts grant",
    "admin:revoke": "bun run src/scripts/manage-platform-admin.ts revoke",
    "admin:backfill-users": "bun run src/scripts/backfill-admin-user-fields.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@ayooda/shared": "workspace:*",
    "@google/generative-ai": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pinecone-database/pinecone": "^3.0.0",
    "ai": "^7.0.48",
    "firebase-admin": "^12.2.0",
    "hono": "^4.4.0",
    "langfuse": "^3.38.20",
    "stripe": "^22.3.1",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "^1.3.12",
    "typescript": "^5.4.5"
  }
}
