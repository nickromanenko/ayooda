rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Workspace document: server-only. The Admin SDK (used by the Hono API
    // and the dashboard layout) bypasses these rules entirely, and no
    // client-side code reads or writes this document. It must stay
    // client-inaccessible because it stores the encrypted openRouterKey,
    // which must never be client-readable.
    match /workspaces/{workspaceId} {
      allow read, write: if false;

      match /knowledge/{docId} {
        allow read, write: if request.auth != null
          && callerData().workspaceId == workspaceId
          && callerData().role != 'member';
      }

      match /channels/{channelId} {
        allow read, write: if request.auth != null
          && callerData().workspaceId == workspaceId
          && callerData().role != 'member';
      }

      match /conversations/{conversationId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == workspaceId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == workspaceId;
        }
      }
    }
  }
}
